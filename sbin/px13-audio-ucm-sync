#!/bin/sh
# Regenerate the card-specific UCM override for the ASUS ProArt PX13.
#
# The AMD SoundWire machine driver (kernel <= 7.1 at least) does not put a
# "spk:tas2783" token in the card components string, so the stock
# amd-soundwire.conf never selects a speaker device. We derive a card-specific
# copy of the *currently installed* stock file with SpeakerCodec1 defaulting to
# "tas2783". If a future kernel does emit spk:, its DefineRegex still wins.
#
# Run by install.sh and by an apt DPkg::Post-Invoke hook, so the copy follows
# alsa-ucm-conf updates instead of going stale.
set -eu

UCM=/usr/share/alsa/ucm2
STOCK=$UCM/conf.d/amd-soundwire/amd-soundwire.conf
STATE=/var/lib/px13-audio/ucm-card-longname

[ -r "$STATE" ] || exit 0
[ -r "$STOCK" ] || exit 0
LONGNAME=$(cat "$STATE")
OUT=$UCM/conf.d/amd-soundwire/$LONGNAME.conf

# Never clobber a card file that a package ships.
if dpkg -S "$OUT" >/dev/null 2>&1; then
	exit 0
fi

grep -q '^[[:space:]]*SpeakerCodec1[[:space:]]*""' "$STOCK" || {
	echo "px13-audio: unexpected $STOCK layout, not regenerating override" >&2
	exit 0
}

TMP=$(mktemp "$OUT.XXXXXX")
{
	echo "# GENERATED by px13-audio-ucm-sync from $STOCK - do not edit."
	echo "# Only change vs. stock: SpeakerCodec1 defaults to \"tas2783\"."
	sed 's/^\([[:space:]]*SpeakerCodec1[[:space:]]*\)""/\1"tas2783"/' "$STOCK"
} > "$TMP"
chmod 644 "$TMP"
mv -f "$TMP" "$OUT"
